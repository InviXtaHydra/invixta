# Copy to .env and change the values. Never commit .env.

# PostgreSQL (used by docker compose for the database container and by the backend)
POSTGRES_USER=supportai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=supportai
# Inside docker compose the host is "postgres"; from your machine it's "localhost".
DATABASE_URL=postgresql+psycopg://supportai:change-me@postgres:5432/supportai
# Separate database for the test suite (created automatically by the tests)
TEST_DATABASE_URL=postgresql+psycopg://supportai:change-me@postgres:5432/supportai_test

# JWT signing secret. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call the API from a browser (the React app in phase 3)
CORS_ORIGINS=http://localhost:5173

# --- Phase 2: RAG + AI agent ---------------------------------------------------------------
# Claude API key for the chat agent and RAG answers (https://console.anthropic.com/settings/keys).
# Without it, document upload, semantic search and the RAG evaluation's retrieval part still work;
# /chat and /knowledge-base/ask return 503.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Local embedding model (baked into the Docker image) and the size of its vectors.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Retrieval: chunks per search and the minimum cosine similarity counted as relevant
# (tuned with scripts/evaluate_rag.py).
RAG_TOP_K=5
RAG_MIN_SCORE=0.6

MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
