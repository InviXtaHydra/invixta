# Copy to .env and change the values. Never commit .env.

# PostgreSQL (used by docker compose for the database container and by the backend)
POSTGRES_USER=supportai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=supportai
# Inside docker compose the host is "postgres"; from your machine it's "localhost".
DATABASE_URL=postgresql+psycopg://supportai:change-me@postgres:5432/supportai
# Separate database for the test suite (created automatically by the tests)
TEST_DATABASE_URL=postgresql+psycopg://supportai:change-me@postgres:5432/supportai_test

# development | production. In production the app refuses the placeholder JWT secret below
# and the scripted test LLM.
ENVIRONMENT=development

# JWT signing secret. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins allowed to call the API directly. The React app normally goes through a proxy
# (nginx in Docker, Vite in development), so it doesn't need CORS; this is for other clients.
CORS_ORIGINS=http://localhost:5173

# --- RAG + AI agent ---------------------------------------------------------------
# The language model runs locally in Ollama (free, no API key): https://ollama.com
# Install it, then download the model once with:  ollama pull qwen3:8b
# From inside Docker, Ollama on your own machine is reachable as host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:8b
# ollama = the local model. scripted = rule-based stand-in for the end-to-end tests (see docker-compose.e2e.yml).
LLM_PROVIDER=ollama
# qwen3 can "think" before answering: better reasoning, but much slower on a laptop.
LLM_THINK=false

# Local embedding model (baked into the Docker image) and the size of its vectors.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Retrieval: chunks per search and the minimum cosine similarity counted as relevant
# (tuned with scripts/evaluate_rag.py).
RAG_TOP_K=5
RAG_MIN_SCORE=0.6

MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# Rate limits (per backend process): failed logins per email, chat messages per user, per minute.
LOGIN_ATTEMPTS_PER_MINUTE=10
CHAT_MESSAGES_PER_MINUTE=20
