# Copy to .env and change the values. Never commit .env.

# PostgreSQL (used by docker compose for the database container and by the backend)
POSTGRES_USER=supportai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=supportai
# Inside docker compose the host is "postgres"; from your machine it's "localhost".
DATABASE_URL=postgresql+psycopg://supportai:change-me@postgres:5432/supportai
# Separate database for the test suite (created automatically by the tests)
TEST_DATABASE_URL=postgresql+psycopg://supportai:change-me@postgres:5432/supportai_test

# JWT signing secret. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call the API from a browser (the React app in phase 3)
CORS_ORIGINS=http://localhost:5173

# Size of the embedding vectors stored in document_chunks (phase 2, local bge-small model = 384)
EMBEDDING_DIM=384
